# EPGDeck Docker Environment Variables Example
# コピーして .env を作成し、環境に合わせて調整してください:
#   $ cp .env.example .env

# コンテナを実行するホスト側の UID / GID
# ホストの一般ユーザー（id -u / id -g）に合わせて設定することで、
# 作成される録画ファイルがホストや Samba / NAS 上で適切な所有者になります。
PUID=1000
PGID=1000

# 公開ポート番号
PORT=8888

# タイムゾーン
TZ=Asia/Tokyo

# ホスト側のデータ保存先ディレクトリ（Samba / NAS マウントパスも指定可能）
RECORDED_DIR=./recorded
THUMBNAIL_DIR=./thumbnail
CONFIG_DIR=./config
LOGS_DIR=./logs
DATA_DIR=./data

