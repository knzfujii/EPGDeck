{
    "name": "epgdeck-client",
    "version": "0.3.0-beta.4",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.3.0"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "watch": "vite build --watch --mode development",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "lint": "svelte-check --tsconfig ./tsconfig.json",
        "format": "prettier --write 'src/**/*.{js,ts,svelte}'",
        "format:check": "prettier --check 'src/**/*.{js,ts,svelte}'"
    },
    "dependencies": {
        "@lucide/svelte": "1.60.0",
        "aribb24.js": "2.0.34",
        "hls.js": "1.7.3",
        "hono": "4.13.13",
        "mpegts.js": "1.8.2",
        "socket.io-client": "4.8.4",
        "svelte": "5.57.2"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "24.19.2",
        "prettier": "3.9.10",
        "prettier-plugin-svelte": "4.1.1",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.0.0",
        "vite": "8.3.4"
    }
}
