{
    "name": "epgdeck-client",
    "version": "0.1.0-alpha.2",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.3.0"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "watch": "vite build --watch --mode development",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "lint": "svelte-check --tsconfig ./tsconfig.json",
        "format": "prettier --write 'src/**/*.{js,ts,svelte}'",
        "format:check": "prettier --check 'src/**/*.{js,ts,svelte}'"
    },
    "dependencies": {
        "@lucide/svelte": "1.44.0",
        "aribb24.js": "2.0.25",
        "hls.js": "1.7.2",
        "mpegts.js": "1.8.2",
        "socket.io-client": "4.8.3",
        "svelte": "^5.0.0"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "7.3.0",
        "@tailwindcss/vite": "^4.0.0",
        "prettier": "3.9.6",
        "prettier-plugin-svelte": "4.1.1",
        "svelte-check": "^4.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.0.0",
        "vite": "8.3.0"
    }
}
