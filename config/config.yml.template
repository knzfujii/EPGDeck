# ==============================================================================
# EPGDeck Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. サーバー設定 (Server)
# ------------------------------------------------------------------------------
server:
  port: 8888
  mirakurun: http+unix://%2Fvar%2Frun%2Fmirakurun.sock/
  # subDirectory: /epgdeck/
  # isAllowAllCORS: false
  # uid: 1000
  # gid: 1000
  # https:
  #   port: 8443
  #   key: /path/to/server.key
  #   cert: /path/to/server.crt
  #   ca: /path/to/ca.crt

# ------------------------------------------------------------------------------
# 2. データベース設定 (Database)
# ------------------------------------------------------------------------------
database:
  type: sqlite   # sqlite | mysql | postgres

  # SQLite 設定
  # sqlite:
  #   extensions:
  #     - '/path/to/regexp.so'
  #   regexp: true

  # MySQL 設定
  # mysql:
  #   host: 127.0.0.1
  #   port: 3306
  #   user: epgdeck
  #   password: epgdeck_password
  #   database: epgdeck
  #   charset: utf8mb4

  # PostgreSQL 設定
  # postgres:
  #   host: 127.0.0.1
  #   port: 5432
  #   user: epgdeck
  #   password: epgdeck_password
  #   database: epgdeck

# ------------------------------------------------------------------------------
# 3. ログ設定 (Log)
# ------------------------------------------------------------------------------
log:
  level: info          # debug | info | warn | error
  console: true        # コンソールへのカラー出力
  file:
    enabled: true      # ファイル出力
    path: '%ROOT%/logs/epgdeck.log'
    maxSize: 10485760  # 10MB
    backups: 5         # 保持世代数
  bufferSize: 1000     # Web/Socket.io表示用メモリバッファ保持件数

# ------------------------------------------------------------------------------
# 4. 番組表・EPG設定 (EPG)
# ------------------------------------------------------------------------------
epg:
  intervalMinutes: 10
  replaceEnclosingCharacters: true   # [字] や [解] などの囲み文字を置換するか
  # channelOrder: [1, 2, 3]          # チャンネル並び順 (Channel ID)
  # sidOrder: [1024, 1025]           # サービスID並び順
  # excludeChannels: [10]            # 除外チャンネル
  # excludeSids: [1026]              # 除外サービスID

# ------------------------------------------------------------------------------
# 5. 録画設定 (Recording)
# ------------------------------------------------------------------------------
recording:
  filenameFormat: '%YEAR%年%MONTH%月%DAY%日%HOUR%時%MIN%分%SEC%秒-%TITLE%'
  fileExtension: .m2ts
  directories:
    - name: recorded
      path: '%ROOT%/recorded'
      # limitThreshold: 107374182400   # 100GB以下になったら古い録画を自動削除
  # tempDir: '%ROOT%/recorded_tmp'      # 一時録画ディレクトリ（録画完了後に正規ディレクトリへ移動）
  historyRetentionDays: 90             # 録画履歴の保持期間(日)
  storageCheckIntervalSeconds: 60      # ディスク空き容量監視間隔(秒)
  priority:
    recording: 2                       # 通常録画時のMirakurun優先度
    conflict: 1                        # 重複録画時のMirakurun優先度
    streaming: 0                       # ライブ配信時のMirakurun優先度
  timeSpecifiedStartMargin: 1          # 時刻指定予約の開始マージン(秒)
  timeSpecifiedEndMargin: 2            # 時刻指定予約の終了マージン(秒)
  thumbnail:
    path: '%ROOT%/thumbnail'
    size: 480x270
    positionSeconds: 5
    # cmd: '%FFMPEG% -ss %THUMBNAIL_POSITION% -y -i %INPUT% -vframes 1 -f image2 -s %THUMBNAIL_SIZE% %OUTPUT%'
  dropLog:
    enabled: true
    path: '%ROOT%/drop'
  uploadTempDir: '%ROOT%/data/upload'

# ------------------------------------------------------------------------------
# 6. エンコード設定 (Encode)
# ------------------------------------------------------------------------------
encode:
  binaries:
    ffmpeg: /usr/lib/jellyfin-ffmpeg/ffmpeg
    ffprobe: /usr/lib/jellyfin-ffmpeg/ffprobe
  maxProcesses: 4
  concurrency: 1
  presets:
    - name: H.264-1080p
      script: enc_1080p.js
      suffix: .mp4
      rate: 4.0
    - name: H.264-720p
      script: enc_720p.js
      suffix: .mp4
      rate: 2.5
    # - name: H.264-VAAPI
    #   script: enc_vaapi.js
    #   suffix: .mp4
    #   rate: 4.0
    # - name: H.264-QSV
    #   script: enc_qsv.js
    #   suffix: .mp4
    #   rate: 4.0
    # - name: H.264-NVENC
    #   script: enc_nvenc.js
    #   suffix: .mp4
    #   rate: 4.0

# ------------------------------------------------------------------------------
# 7. 外部連携・フック設定 (Hooks)
# ------------------------------------------------------------------------------
