import { runEncode } from './enc_helper.js';

/**
 * EPGDeck 標準エンコードスクリプト (CPU H.264)
 * - 地デジ 1440x1080 は原寸維持し、SAR 4:3 / DAR 16:9 で再生互換性を保護
 * - 出力解像度を 1080p 以下に制限 (maxHeight: 1080)
 * - 二重音声（デュアルモノ）の2トラック（主音声/副音声）分離
 * - Web UI 進捗バーとのリアルタイム連動
 */
runEncode({
    codec: 'libx264',
    preset: 'medium',
    // tune: 'animation', // アニメ番組等の輪郭線保持 ('animation' | 'film' | 'grain' 等)
    crf: 23,
    // maxrate: '4000k',  // 最大ビットレート制限 (bufsize は未指定時 maxrate*2 が自動設定)
    maxHeight: 1080,
    dualMono: 'split', // 'split' (2トラック分離) | 'main' (主音声のみ) | 'sub' (副音声のみ)
    subtitle: process.env.SUBTITLE === 'true' || false, // true で字幕を保持 (mov_text)、config.yml の設定または環境変数を反映
});
