import { runEncode } from './enc_helper.js';

/**
 * Intel QuickSync Video (QSV) ハードウェアアクセラレーション設定
 * - h264_qsv / global_quality 23
 */
runEncode({
    codec: 'h264_qsv',
    preset: 'medium',
    crf: 23,
    maxHeight: 1080,
    dualMono: 'split',
    subtitle: process.env.SUBTITLE === 'true' || false, // config.yml の preset.subtitle または環境変数 SUBTITLE を反映
});
