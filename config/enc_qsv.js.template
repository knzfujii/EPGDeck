import { runEncode } from './enc_helper.js';

/**
 * Intel QuickSync Video (QSV) ハードウェアアクセラレーション設定 (Intel Core 第6世代以降推奨)
 * ※ 本テンプレートは設定例（雛形）であり、実機環境での動作未確認です。
 * - h264_qsv または hevc_qsv
 * - preset: veryfast 〜 veryslow, 標準は medium
 * - crf: -global_quality 値 (1-51, 標準23)
 * - 自然・波・海などの容量肥大化を防ぐには、maxrate / bufsize の指定を推奨
 */
runEncode({
    codec: 'h264_qsv', // または 'hevc_qsv'
    preset: 'medium',
    crf: 23,
    // maxrate: '6000k',  // 容量爆発を防ぐ上限キャップ
    // bufsize: '12000k',
    maxHeight: 1080,
    dualMono: 'split',
    subtitle: process.env.SUBTITLE === 'true' || false, // config.yml の preset.subtitle または環境変数 SUBTITLE を反映
});
