{
    "name": "epgdeck",
    "version": "0.1.0-alpha.1",
    "description": "DTV Software in Japan.",
    "main": "dist/index.js",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "all-install": "npm i --no-save && cd client && npm i --no-save",
        "start": "node dist/index.js",
        "build": "npm run build-server && npm run build-client",
        "build-server": "npm run lint && npm run format && npm run compile",
        "build-client": "cd client && npm run build",
        "lint": "eslint --fix --ext .ts src/",
        "format": "prettier --check --write 'src/**/*.ts'",
        "compile": "tsc",
        "dev": "npm-run-all -p dev:server dev:client",
        "dev:server": "npm-run-all -p watch:server start:dev",
        "dev:client": "cd client && npm run watch",
        "watch:server": "tsc --watch --preserveWatchOutput",
        "start:dev": "nodemon",
        "watch": "npm run dev",
        "backup": "node dist/DBTools.js -m backup -o",
        "restore": "node dist/DBTools.js -m restore -o",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/knzfujii/EPGDeck.git"
    },
    "author": "l3tnun",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/knzfujii/EPGDeck/issues"
    },
    "homepage": "https://github.com/knzfujii/EPGDeck#readme",
    "dependencies": {
        "@libsql/client": "0.17.4",
        "arib-subtitle-timedmetadater": "4.0.10",
        "aribts": "2.1.12",
        "axios": "1.6.8",
        "body-parser": "1.20.2",
        "cors": "2.8.5",
        "diskusage-ng": "1.0.4",
        "drizzle-orm": "0.45.2",
        "eventsource": "2.0.2",
        "express": "4.19.2",
        "express-openapi": "12.1.3",
        "file-type": "16.5.4",
        "inversify": "6.0.2",
        "js-yaml": "4.1.0",
        "lodash": "4.17.21",
        "log4js": "6.9.1",
        "minimist": "1.2.8",
        "mirakurun": "3.9.0-rc.4",
        "mkdirp": "3.0.1",
        "multer": "1.4.3",
        "mysql2": "3.24.2",
        "openapi-types": "12.1.3",
        "reflect-metadata": "0.2.2",
        "socket.io": "4.7.5",
        "source-map-support": "0.5.21",
        "swagger-ui-dist": "5.17.2",
        "url-join": "4.0.1"
    },
    "devDependencies": {
        "@types/body-parser": "1.19.5",
        "@types/eventsource": "1.1.15",
        "@types/express": "4.17.21",
        "@types/file-type": "10.9.1",
        "@types/js-yaml": "4.0.9",
        "@types/lodash": "4.17.0",
        "@types/minimist": "1.2.5",
        "@types/mkdirp": "1.0.2",
        "@types/multer": "1.4.9",
        "@types/node": "18.11.9",
        "@types/socket.io": "3.0.1",
        "@types/source-map-support": "0.5.10",
        "@types/url-join": "4.0.3",
        "@typescript-eslint/eslint-plugin": "7.8.0",
        "@typescript-eslint/parser": "7.8.0",
        "drizzle-kit": "0.31.10",
        "eslint": "8.57.0",
        "eslint-config-prettier": "8.10.0",
        "nodemon": "3.1.14",
        "npm-run-all": "4.1.5",
        "prettier": "3.2.5",
        "typescript": "5.4.5",
        "vitest": "3.2.7"
    }
}
