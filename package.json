{
  "name": "epgdeck",
  "version": "0.3.0-beta.1",
  "description": "DTV Software in Japan.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.3.0"
  },
  "workspaces": [
    "client",
    "packages/*"
  ],
  "scripts": {
    "start": "node --enable-source-maps dist/index.js",
    "build": "run-p build:server build:client",
    "build:packages": "npm --prefix packages/arib-probe run build",
    "build:server": "npm run build:packages && npm run compile",
    "build:client": "npm --prefix client run build",
    "dev": "run-p dev:server dev:client",
    "dev:server": "run-p watch:server start:dev",
    "dev:client": "npm --prefix client run watch",
    "watch:server": "tsc --watch --preserveWatchOutput",
    "start:dev": "nodemon",
    "lint": "eslint --cache --fix src/ test/",
    "lint:check": "eslint --cache src/ test/",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' && npm --prefix client run format",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' && npm --prefix client run format:check",
    "typecheck": "npm run build:packages && tsc --project tsconfig.test.json",
    "compile": "npm run build:packages && tsc",
    "check:quick": "npm run build:packages && run-p lint:check typecheck test test:esm check:quick:client",
    "check:quick:client": "npm --prefix client run lint",
    "check:server": "npm run build:packages && run-p lint:check format:check typecheck && run-p compile test test:esm",
    "check:client:lint": "npm --prefix client run lint",
    "check:client:format": "npm --prefix client run format:check",
    "check:client:build": "npm run build:client",
    "check:client": "run-p check:client:*",
    "check": "run-p check:server check:client && npm run test:e2e",
    "backup": "node --enable-source-maps dist/DBTools.js -m backup -o",
    "restore": "node --enable-source-maps dist/DBTools.js -m restore -o",
    "migrate-thumbnails": "node --enable-source-maps dist/tools/MigrateThumbnails.js",
    "move-recorded": "node --enable-source-maps dist/tools/MoveRecordedFiles.js",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:compat": "mise exec node@22 -- vitest run",
    "test:esm": "node test/smoke/esm_interop.js",
    "test:watch": "vitest",
    "test:mysql": "TEST_MYSQL=true vitest run test/integration/mysql.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:file": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knzfujii/EPGDeck.git"
  },
  "author": "l3tnun",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/knzfujii/EPGDeck/issues"
  },
  "homepage": "https://github.com/knzfujii/EPGDeck#readme",
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-validator": "0.9.1",
    "@libsql/client": "0.18.0",
    "arib-probe": "*",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "js-yaml": "5.4.2",
    "mirakurun": "4.1.5",
    "mysql2": "3.24.5",
    "openapi-types": "12.1.3",
    "rotating-file-stream": "3.2.10",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "test/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "client/src/**/*.{js,ts,svelte}": [
      "npm --prefix client run format",
      "npm --prefix client run lint"
    ]
  },
  "type": "module"
}
