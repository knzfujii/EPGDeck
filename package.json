{
  "name": "epgdeck",
  "version": "0.1.0-alpha.1",
  "description": "DTV Software in Japan.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "all-install": "npm i --no-save && cd client && npm i --no-save",
    "start": "node --enable-source-maps dist/index.js",
    "build": "npm run build-server && npm run build-client",
    "build-server": "npm run lint && npm run format && npm run compile",
    "build-client": "cd client && npm run build",
    "lint": "eslint --fix src/ test/",
    "lint:check": "eslint src/ test/",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "typecheck": "tsc --project tsconfig.test.json",
    "compile": "tsc",
    "check:server": "npm run lint:check && npm run format:check && npm run typecheck && npm run compile && npm run test",
    "check:client": "cd client && npm run lint && npm run format:check && npm run build",
    "check:e2e": "playwright test",
    "check": "npm run check:server && npm run check:client && npm run check:e2e",
    "dev": "npm-run-all -p dev:server dev:client",
    "dev:server": "npm-run-all -p watch:server start:dev",
    "dev:client": "cd client && npm run watch",
    "watch:server": "tsc --watch --preserveWatchOutput",
    "start:dev": "nodemon",
    "watch": "npm run dev",
    "backup": "node --enable-source-maps dist/DBTools.js -m backup -o",
    "restore": "node --enable-source-maps dist/DBTools.js -m restore -o",
    "migrate-thumbnails": "node --enable-source-maps dist/tools/MigrateThumbnails.js",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mysql": "TEST_MYSQL=true vitest run test/integration/mysql.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knzfujii/EPGDeck.git"
  },
  "author": "l3tnun",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/knzfujii/EPGDeck/issues"
  },
  "homepage": "https://github.com/knzfujii/EPGDeck#readme",
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/swagger-ui": "0.6.1",
    "@libsql/client": "0.18.0",
    "arib-subtitle-timedmetadater": "4.0.10",
    "aribts": "2.1.12",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "inversify": "6.0.2",
    "js-yaml": "5.4.1",
    "log4js": "6.9.1",
    "mirakurun": "4.1.3",
    "mysql2": "3.24.4",
    "openapi-types": "12.1.3",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/socket.io": "3.0.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "test/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "client/src/**/*.{js,ts,svelte}": [
      "npm --prefix client run format",
      "npm --prefix client run lint"
    ]
  }
}
