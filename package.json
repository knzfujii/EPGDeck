{
  "name": "epgdeck",
  "version": "0.1.0-alpha.1",
  "description": "DTV Software in Japan.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "all-install": "npm i --no-save && cd client && npm i --no-save",
    "start": "node dist/index.js",
    "build": "npm run build-server && npm run build-client",
    "build-server": "npm run lint && npm run format && npm run compile",
    "build-client": "cd client && npm run build",
    "lint": "eslint --fix --ext .ts src/",
    "lint:check": "eslint --ext .ts src/",
    "format": "prettier --check --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "compile": "tsc",
    "check:server": "npm run lint && npm run format && npm run compile && npm run test",
    "check:client": "cd client && npm run lint && npm run build",
    "check": "npm run check:server && npm run check:client",
    "dev": "npm-run-all -p dev:server dev:client",
    "dev:server": "npm-run-all -p watch:server start:dev",
    "dev:client": "cd client && npm run watch",
    "watch:server": "tsc --watch --preserveWatchOutput",
    "start:dev": "nodemon",
    "watch": "npm run dev",
    "backup": "node dist/DBTools.js -m backup -o",
    "restore": "node dist/DBTools.js -m restore -o",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knzfujii/EPGDeck.git"
  },
  "author": "l3tnun",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/knzfujii/EPGDeck/issues"
  },
  "homepage": "https://github.com/knzfujii/EPGDeck#readme",
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/swagger-ui": "0.6.1",
    "@libsql/client": "0.18.0",
    "arib-subtitle-timedmetadater": "4.0.10",
    "aribts": "2.1.12",
    "axios": "1.20.0",
    "diskusage-ng": "1.0.4",
    "drizzle-orm": "0.45.2",
    "eventsource": "5.1.1",
    "file-type": "16.5.4",
    "hono": "4.13.5",
    "inversify": "6.0.2",
    "js-yaml": "4.1.0",
    "lodash": "4.18.1",
    "log4js": "6.9.1",
    "minimist": "1.2.8",
    "mirakurun": "4.1.3",
    "mkdirp": "3.0.1",
    "mysql2": "3.24.3",
    "openapi-types": "12.1.3",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.3",
    "source-map-support": "0.5.21",
    "url-join": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/file-type": "10.9.1",
    "@types/js-yaml": "4.0.9",
    "@types/lodash": "4.17.25",
    "@types/minimist": "1.2.5",
    "@types/mkdirp": "1.0.2",
    "@types/node": "24.13.3",
    "@types/socket.io": "3.0.1",
    "@types/source-map-support": "0.5.10",
    "@types/url-join": "4.0.3",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "5.4.5",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "client/src/**/*.{js,ts,svelte}": [
      "npm --prefix client run lint"
    ]
  }
}
